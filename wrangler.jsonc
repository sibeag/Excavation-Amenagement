{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ensemblesb",
  "main": "worker.js",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "RESEND_FROM_EMAIL": "Espace SB <espacesb@militime.ai>",
    "RESEND_TO_EMAIL": "p@pasquin.ca",
    "FORM_ALLOWED_ORIGINS": "https://www.espacesb.com",
    "GOOGLE_ADS_CONVERSION_TARGET": "AW-18139948408/JFtbCMih59gcEPjK5slD"
  }
}
